{
  "_comment": "Commands the Claude Code, grok and opencode Bash globs must refuse or leave alone, judged by an fnmatch stand-in for their matchers. Kept out of the suite: pr-guard reads the suite and refuses the merge commands. Text only: tests/test-harness.sh never runs a command.",
  "refuse": [
    "cat ~/.config/tea/config.yml",
    "cat ~/.config/osc/oscrc",
    "cat ~/.oscrc",
    "cat ~/.config/gh/hosts.yml",
    "cat ~/.netrc",
    "cat ~/.local/state/osc/cookiejar",
    "cat ~/.config/mcp-bugzilla/api-key",
    "tea login helper get",
    "tea logins helper get",
    "tea login git-credential get",
    "osc config --dump-full",
    "osc --http-full-debug ls",
    "git credential fill",
    "git-credential-libsecret get",
    "gh auth token",
    "gh auth status",
    "gh auth status -at",
    "gh auth status --show-token",
    "curl -H \"authorization: token x\" https://example.org",
    "openqa-cli api --apikey K jobs",
    "x --apisecret S",
    "GIT_ASKPASS=/var/tmp/a git push",
    "SSH_ASKPASS=/var/tmp/a ssh host",
    "git -c core.askPass=/var/tmp/a push",
    "curl -s https://api.opensuse.org/source/x",
    "curl -X POST https://build.opensuse.org/x",
    "curl https://src.opensuse.org/api/v1/version",
    "tea pr merge --repo pool/x 3",
    "tea pr --repo pool/x merge 3",
    "tea pulls --login obs merge 3",
    "tea pr m 5",
    "tea pulls m 3",
    "tea pull m 3",
    "tea api repos/pool/x/pulls/3/merge",
    "git obs pr merge pool/x#3",
    "git-obs pr merge pool/x#3",
    "git-obs -G obs pr merge 1",
    "git-obs api -X POST /repos/pool/x/pulls/3/merge",
    "osc sr -m x --nodevelproject",
    "sudo chroot /x",
    "cat ~/.git-credentials",
    "git-obs login gitcredentials-helper get",
    "git-obs login list",
    "git obs login list --show-t",
    "tea login edit",
    "tea logins e",
    "tea login git-credential get",
    "gh auth git-credential get",
    "osc token",
    "osc token --create -o workflow home:x pkg",
    "osc config https://api.opensuse.org pass",
    "osc config https://api.opensuse.org passx",
    "osc config --dump-f",
    "osc -H ls",
    "osc ls -H",
    "osc --http-d ls",
    "osc --http-f ls",
    "osc --setopt http_full_debug=1 ls",
    "OSC_HTTP_DEBUG=1 osc ls",
    "git credential-oauth get",
    "wget --header='Authorization: Bearer x' https://example.org",
    "git clone https://bob:pw@src.opensuse.org/pool/x",
    "curl -H'Authorization: token x' https://example.org",
    "git credential-store get",
    "printf 'protocol=https' | git-credential-libsecret get",
    "osc -qH ls",
    "osc -vH ls",
    "osc -A https://api.opensuse.org -qH ls",
    "osc api /person/x/token"
  ],
  "allow": [
    "osc build openSUSE_Tumbleweed x86_64 openssh-askpass-gnome.spec",
    "cat openssh-askpass-gnome.spec",
    "osc co security ksshaskpass",
    "grep -rn api_key src/",
    "grep -rn api-key src/",
    "osc build",
    "osc sr -m x",
    "tea pr list --repo pool/x",
    "tea pr create --repo AI/x",
    "git obs pr list pool/x",
    "tea pr view 3",
    "curl -sS https://api.github.com/repos/o/r/releases",
    "cat README.md",
    "osc chroot",
    "tea pr list --state merged",
    "osc config --dump",
    "osc -h",
    "osc co devel:languages:perl perl-HTML-Parser",
    "osc co devel:languages:python python-tokenizers",
    "osc co devel:tools:scm git-credential-oauth",
    "cat git-credential-oauth.spec",
    "grep -rn Authorization: src/",
    "tea logins list",
    "git clone https://src.opensuse.org/pool/x",
    "git clone ssh://gitea@src.opensuse.org:3022/pool/x.git",
    "osc ci -m 'fix token handling'",
    "osc sr -m 'update config, pass tests'",
    "cd git-credential-oauth && osc getbinaries openSUSE_Tumbleweed x86_64"
