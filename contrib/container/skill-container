}
# What a client needs of the running instance: its image and the directory it
# works in.
connect() {
	readstate
	running || die "$inst is not running: 'skill-container up $inst' starts it"
	guarded "$(plugins)" || die "$inst runs without both guard plugins: 'skill-container down $inst', then 'up'"
	forget
	image=$(podman inspect --format '{{.Image}}' "$ctr")
	[[ $image =~ ^[0-9a-f]{64}$ ]] || die "cannot read the image of $ctr"
	inside_now=$(podman inspect --format '{{.Config.WorkingDir}}' "$ctr")
	[[ $inside_now == /?* && $inside_now != *[,:]* ]] || die "cannot read the work directory of $ctr: $inside_now"
