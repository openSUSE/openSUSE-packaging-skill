}
# The client loads, where it runs, each plugin the server names, and the agent
# can make the server name its own. So it runs in a container beside the
# server's, from the same image and not on the host: with the server's network
# and users, the server password, your terminal and nothing else of yours. A
# session belongs to its directory, so it starts in an empty one where the
# work directory is. No proxy of yours is passed on: the password would go to
# it. FORCE_HYPERLINK=0: it sends the terminal no link with a target of its own.
# No log: podman would keep what the client draws, what you typed included.
client() {
	podman run --rm --pull=never --network "container:$ctr" --userns "container:$ctr" \
		--user "$(id -u):$(id -g)" --read-only --cap-drop=all \
		--security-opt no-new-privileges --init --http-proxy=false --log-driver=none \
		--secret "$name-$inst-server-password,type=env,target=OPENCODE_PASSWORD" \
		--env FORCE_HYPERLINK=0 --env TERM --env COLORTERM \
		--tmpfs /home/agent/.local/share/opencode:rw,mode=0700,U \
		--tmpfs /home/agent/.local/state:rw,mode=0700,U \
		--tmpfs /home/agent/.cache:rw,mode=0700,U \
		--tmpfs "$inside_now:ro,mode=0555,notmpcopyup" --workdir "$inside_now" "$@"
}
cmd_password() {
	[ $# = 0 ] || die "password takes no argument"
	readstate
	connect
	secret "$inst-server-password"
}
# The ids of the sessions with a turn in flight: busy past idle.
busy_sessions() {
	local page n cursor=''
	for _ in $(seq 100); do
		page=$(api GET "/api/session?limit=1000${cursor:+&cursor=$cursor}") || return 1
		n=$(jq -r 'if (.data | type) == "array" then .data | length else error("no list") end' <<<"$page") || return 1
		[ "$n" != 0 ] || return 0
		# The ids are printed: one that is more than an id is an agent's text.
		jq -r '.data[] | select((.time.busy // 0) > (.time.idle // 0)) | .id |
			if type == "string" and (test("[^A-Za-z0-9_]") | not) then . else error("id") end' <<<"$page" 2>/dev/null || return 1
		cursor=$(jq -r '.cursor.next // ""' <<<"$page") || return 1
		[[ $cursor =~ ^[A-Za-z0-9_-]+$ ]] || return 1
	done
	return 1
}
# The containers in the server's network namespace: an attached client. podman
# names a shared network by the server's id, not by the name it was given, so
# the namespaces are compared. 0: one is there, 1: none, 2: it cannot be told.
client_containers() {
	local out n ns net=''
	out=$(podman ps --namespace --format '{{.Names}} {{.Namespaces.NET}}') || return 2
	while read -r n ns; do
		[ "$n" != "$ctr" ] || net=$ns
	done <<<"$out"
	[[ $net =~ ^[0-9]+$ ]] || return 2
	while read -r n ns; do
		[ "$n" = "$ctr" ] || [ "$ns" != "$net" ] || return 0
	done <<<"$out"
	return 1
}
# True when a restart would interrupt nothing: no session is busy and no
# client is on the instance.
idle_check() {
	local busy clients
	busy=$(busy_sessions) || die "cannot list the sessions of $ctr"
	if [ -n "$busy" ]; then
		echo "skill-container: a session of $inst is busy:" >&2
		printf '%s\n' "$busy" >&2
		return 1
	fi
	client_containers && clients=0 || clients=$?
	case $clients in
	0)
		echo "skill-container: a client is on $inst" >&2
		return 1
		;;
	1) return 0 ;;
	*) die "cannot tell whether a client is on $ctr" ;;
	esac
}
cmd_idle() {
	[ $# = 0 ] || die "idle takes no argument"
	readstate
	running || die "$inst is not running"
