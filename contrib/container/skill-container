	idle_check || die "$inst is not idle: update waits for the night"
	ensure_password
	systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
	systemctl --user restart "$unit" >/dev/null || die "$inst would not restart"
	start_wait
	forget
	relogin
	trap - EXIT
	echo "$inst is updated"
}
cmd_import() {
	local from='' memory="${HOME}/.local/share/mcp-memory/memory.json" tmp f id ids title n=0
	local home store volumes runtime
	while (($#)); do
		case $1 in
		--from)
			from=${2?--from needs a directory}
			shift 2
			;;
		--memory)
			memory=${2?--memory needs a file}
			shift 2
			;;
		*) die "import: unknown argument: $1" ;;
		esac
	done
	[ -n "$from" ] || die "import: --from <directory> is required"
	[[ $from == /* ]] || from=$start/$from
	readstate
	running || die "$inst is not running: 'skill-container up $inst' starts it"
	[ -d "$from" ] || die "not a directory: $from"
	real "$from"
	from=$(realpath -- "$from")
	# The copy hands the agent the whole tree: a project, not what the work
	# directory itself may not be.
	home=$(realpath -- "$HOME")
	store=$(podman info --format '{{.Store.GraphRoot}}')
	volumes=$(podman info --format '{{.Store.VolumePath}}')
	runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
	if [ "$from" = / ] || [[ $home/ == "$from"/* || $from/ == "$home"/.* ]] ||
		nested "$from" "$(realpath -m -- "$conf")" || nested "$from" "$(realpath -m -- "$store")" ||
		nested "$from" "$(realpath -m -- "$volumes")" || nested "$from" "$(realpath -m -- "$runtime")"; then
		die "refusing $from: import copies a project, not your home directory, what holds it, a dot-directory in it, or what holds your logins, podman's storage or your runtime directory"
	fi
	[ -z "$(ls -A -- "$workdir")" ] || die "refusing $workdir: it is not empty; move its files away and run import again"
	! nested "$from" "$workdir" || die "refusing $from: it holds the work directory or lies in it"
	resolve
	# Absolute paths: the subshells below cd into the project and must not
	# resolve commands there.
	jqbin=$(command -v jq) || die "no jq: $jqbin"
	[[ $memory == /* ]] || memory=$start/$memory
	# Every check passes before anything is copied or seeded.
	check_workdir
	check_memory
	if podman run --rm --userns=keep-id --user "$(id -u):$(id -g)" --read-only \
		--cap-drop=all --security-opt no-new-privileges --init \
		--volume "$name-$inst-memory:/seed:U" "$image" sh -c 'test -e /seed/'"$memname" 2>/dev/null; then
		die "the memory volume of $inst is already seeded: 'podman volume rm $name-$inst-memory' starts it over"
	fi
	tmp=$(mktemp -d) || die "no temporary directory"
	trap 'rm -rf "$tmp"' EXIT
	ids=$(cd "$from" && OPENCODE_DISABLE_PROJECT_CONFIG=1 "$opencode" session list --format json |
		"$jqbin" -r '.[].id') || die "cannot list the sessions in $from"
	for id in $ids; do
		[[ $id =~ ^[A-Za-z0-9_-]+$ ]] || die "a session in $from has an unexpected id"
		(cd "$from" && OPENCODE_DISABLE_PROJECT_CONFIG=1 "$opencode" session export "$id" >"$tmp/$id.json") ||
			die "cannot export the session $id"
		if jq -e '.info.time.busy > .info.time.idle' "$tmp/$id.json" >/dev/null; then
			title=$(jq -r '.info.title // ""' "$tmp/$id.json" | plain)
			die "the session '$title' ($id) is busy: close the host client and run import again"
		fi
	done
	# The files, as they are: where the file system can share blocks the copy takes no
	# extra space. The agent gets the copy; the original stays yours.
	shopt -s dotglob nullglob
	for f in "$from"/*; do
		case ${f##*/} in
		.claude | .tmp* | skill-container-ws) continue ;;
		esac
		cp -a --reflink=auto "$f" "$workdir/" || die "the copy of $f failed"
	done
	shopt -u dotglob nullglob
	# The memory graph, once: the volume keeps what the agent writes from here.
	podman run --rm --userns=keep-id --user "$(id -u):$(id -g)" --read-only \
		--cap-drop=all --security-opt no-new-privileges --init \
		--volume "$name-$inst-memory:/seed:U" --volume "${memory%/*}:/src:ro,Z" \
		"$image" cp "/src/${memory##*/}" "/seed/$memname" >/dev/null ||
		die "the memory graph was not seeded"
	for id in $ids; do
		filtered timeout -k 5 60 podman exec -i "$ctr" opencode session import --server "$inner" --directory "$inside" /dev/stdin <"$tmp/$id.json" >/dev/null ||
			die "cannot import the session $id"
		n=$((n + 1))
	done
	trap - EXIT
	rm -rf "$tmp"
	echo "$inst imported $from: its files, the memory graph and $n sessions"
}
cmd=${1-}
[ $# -eq 0 ] || shift
case $cmd in
secrets) cmd_secrets "$@" ;;
ssh-key) cmd_ssh_key "$@" ;;
install | up | attach | run | down | uninstall | password | import | update | idle)
	take_instance "${1-}"
	[ $# = 0 ] || shift
	case $cmd in
	install) cmd_install "$@" ;;
	up) cmd_up "$@" ;;
	attach)
		known "$@"
		# Without one the client stays, unseen, until its container is removed.
		{ [ -t 0 ] && [ -t 1 ]; } || die "attach needs a terminal"
		readstate
		connect
		client --interactive --tty --detach-keys= "$image" opencode --server "$inner" "$@"
		;;
	run)
		known "$@"
		readstate
		connect
		# The two streams stay apart; pipefail keeps the client's exit status.
		{ client "$image" opencode run --server "$inner" "$@" 2>&1 >&3 3>&- | plain >&2 3>&-; } 3>&1 | plain
		;;
	down) cmd_down "$@" ;;
	uninstall) cmd_uninstall "$@" ;;
	password) cmd_password "$@" ;;
	import) cmd_import "$@" ;;
	update) cmd_update "$@" ;;
	idle) cmd_idle "$@" ;;
	esac
	;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
