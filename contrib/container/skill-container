#!/bin/bash
# Runs the openSUSE packaging agent in a container and as a user service: the
# launcher copies no login itself (secrets does, run by you alone), starts the
# server through systemd and opens a client on it, in a container of its own.
set -euo pipefail
# A range such as a-z takes in accented letters in most locales.
export LC_ALL=C
name=${SKILL_CONTAINER_NAME:-opensuse-packaging}
conf=${XDG_CONFIG_HOME:-$HOME/.config}
userconf=$conf/skill-container/$name
opencode=${OPENCODE:-opencode}
inner=http://127.0.0.1:4096
# The memory graph the image reads when no volume holds one yet.
memname=memory.jsonl
# When the retries of the command end: its first try sets it (see retried).
cutoff=
die() {
	# Text before it may have left the terminal's attributes set: the line resets them.
	[ ! -t "$diefd" ] || printf '\033[0m' >&"$diefd"
	echo "skill-container: $*" >&"$diefd"
	exit 1
}
# The stream the launcher started with: a retry hides the errors of its later
# tries, never why the launcher stops.
exec {diefd}>&2
# The agent writes the work directory, and a command takes more than its
# arguments from the directory it starts in: python its modules, opencode its
# plugins, the loader a library when one of its lists has an empty entry. The
# launcher's commands start in / and come from the system directories, whatever
# your PATH holds. Your PATH finds one command alone: the opencode that secrets
# asks for the model login.
start=$PWD
cd /
userpath=$PATH
PATH=${SKILL_CONTAINER_PATH:-/usr/local/bin:/usr/bin:/bin}
# The loader's lists as one: it splits LD_LIBRARY_PATH on : and ;, LD_PRELOAD
# on : and spaces, LD_AUDIT on :, and looks a name without a slash up itself.
libs=${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH//;/:}}
preloads() {
	local IFS=: entry list=${LD_PRELOAD-}
	list=${list// /:}:${LD_AUDIT-}
	set -f
	for entry in $list; do
		[[ $entry != */* ]] || libs+=:$entry
	done
	set +f
}
preloads
# A relative entry, or an empty one, is looked up where a command starts. One
# with . or .. in it is not the directory it reads as.
case ":$PATH:$userpath$libs:" in
*:[!/]*) die "PATH, LD_LIBRARY_PATH, LD_PRELOAD or LD_AUDIT has an entry that is not an absolute path" ;;
*/.[/:]* | */..[/:]*) die "PATH, LD_LIBRARY_PATH, LD_PRELOAD or LD_AUDIT has an entry with a . or .. in it" ;;
esac
case $libs in
*'$'*) die "LD_LIBRARY_PATH, LD_PRELOAD or LD_AUDIT has an entry with a \$, which the loader replaces" ;;
esac
resolve() {
	local found
	{ found=$(PATH=$userpath command -v -- "$opencode") && [[ $found == /* ]]; } ||
		die "no opencode client at an absolute path: $opencode"
	opencode=$found
}
# The launcher's own file, whatever invoked it as.
self=$(realpath -- "${BASH_SOURCE[0]}")
# Stops when commands or libraries are looked up in the work directory $1: by
# an entry that lies there as it is written, or one a link leads there.
offpath() {
	local entry entries
	mapfile -d : -t entries < <(printf %s "$PATH:$userpath$libs")
	for entry in "${entries[@]}"; do
		[[ $entry/ != "$1"/* && $(realpath -m -- "$entry")/ != "$1"/* ]] ||
			die "$entry is on PATH or one of the loader's lists and lies in the work directory $1, which the agent writes"
	done
}
# The opencode flags attach and run pass on, and those of them that take a
# value. Its --auto, and that flag's two other names, answer every permission
# with yes: they are not among them. Nor is --file of run: the client's
# container holds no file of yours. Under attach opencode reads a word that is
# no flag's value as a command or a directory, so there every word is a flag
# or its value.
attachflags='-c --continue -s --session --prompt'
runflags='-c --continue -s --session --fork -m --model --agent --format --title --thinking'
valued='-s --session -m --model --agent --format --title --prompt'
known() {
	local a flag flags=$runflags pending=''
	[ "$cmd" = run ] || flags=$attachflags
	for a; do
		if [ -n "$pending" ]; then
			[[ $a != -* ]] || die "$pending needs a value: one that starts with - is written $pending=VALUE"
			pending=''
		elif [[ $a == -* ]]; then
			flag=${a%%=*}
			[[ $flag != *' '* && " $flags " == *" $flag "* ]] || die "$cmd passes on these opencode flags only: $flags"
			if [[ " $valued " != *" $flag "* ]]; then
				[[ $a != *=* ]] || die "$flag takes no value"
			elif [[ $a != *=* ]]; then
				pending=$a
			fi
		else
			[ "$cmd" = run ] || die "attach takes flags only: opencode reads '$a' as a command or a directory"
		fi
	done
	[ -z "$pending" ] || die "$pending needs a value"
}
usage() {
	cat <<EOF
usage: skill-container secrets --model-auth <integration> [--bugzilla-key FILE] [--new-ssh-key | --ssh-key FILE]
       skill-container ssh-key
       skill-container install <instance> --workdir DIR [--as DIR] [--memory FILE] [--image IMAGE]
       skill-container up <instance> [--model provider/model]
       skill-container attach <instance> [flags]
       skill-container run <instance> [flags] <message>
       skill-container down <instance>
       skill-container uninstall <instance>
       skill-container password <instance>
       skill-container import <instance> --from DIR [--memory FILE]
       skill-container update <instance>
       skill-container idle <instance>
secrets  copies the api.opensuse.org login of osc, the src.opensuse.org login of
         tea, the github.com login of gh, the Bugzilla API key and one opencode
         integration into podman secrets, and makes an SSH key for pushes to
         src.opensuse.org on its first run; --new-ssh-key replaces that key,
         --ssh-key FILE takes a key of yours instead, one without a passphrase.
         It prints the secret names only.
ssh-key  prints the public half of that key: add it to your src.opensuse.org
         account once.
install  writes the units of <instance> for DIR, mounted at --as DIR (default
         the same path), and seeds its memory volume from FILE. Run it again
         after the launcher changed: it refuses until its fixed copy matches.
up       starts <instance> behind a server password of its own.
attach   opens the interface on a running <instance>. The client runs in a
         container of its own, without the work directory and the logins. It
         passes on these opencode flags and no other argument:
         $attachflags
run      sends one message without the interface, with these opencode flags:
         $runflags
         Both refuse any other flag, --auto among them.
down     stops <instance>. Volumes and secrets stay.
uninstall stops <instance> and removes its units and settings. Volumes and
         secrets stay.
password prints the server password of a running <instance>, for a client of
         your own. Run it yourself, never from an agent.
import   copies --from DIR into the work directory of <instance>, with the
         memory graph and the sessions of that project. The container keeps
         running; its volumes must be empty. Run it yourself.
update   pulls the image, unless its name starts with localhost/, and when
         the name then stands for a new one restarts <instance> if no session
         is busy and no client is on it. Enable its timer only after one
         watched run.
idle     answers whether update would restart <instance> now.
EOF
}
# Stores stdin as one secret.
store() { podman secret create --replace "$name-$1" - >/dev/null; }
# A secret's content, for a pipe only.
secret() { podman secret inspect --showsecret --format '{{.SecretData}}' "$name-$1"; }
# The server asks every client for a password. It is created once per
# instance and then kept: the server cannot run without one, so a stable
# secret is the smallest setup that still authenticates every client.
# Rotation is manual: 'podman secret rm' the name below, then start again.
ensure_password() {
	podman secret exists "$name-$inst-server-password" 2>/dev/null ||
		head -c 24 /dev/urandom | base64 | tr -d '\n' | store "$inst-server-password"
}
# What the model or the server wrote reaches the terminal as text, for a
# terminal that reads UTF-8: no control character, and no colour, which could
# hide the launcher's lines after it (concealed, or the background's colour).
# Taking one C1 control out can join the bytes of the next, hence the loop.
plain() {
	LC_ALL=C sed -u -e 's/\x1b\[[0-9;]*m//g' -e 's/[\x00-\x08\x0b-\x1f\x7f]//g' -e ':a' -e 's/\xc2[\x80-\x9f]//g' -e 'ta'
}
# An osc config with the api.opensuse.org login alone. osc reads its own config,
# so a password it keeps obfuscated or in a keyring comes out as well. -I: no
# module comes from PYTHONPATH or the user's site directory.
osc_login() {
	python3 -I - <<'EOF'
import sys
API = "https://api.opensuse.org"
try:
    from osc import conf, credentials
    from osc.OscConfigParser import OscConfigParser
    conf.get_config()
    host = conf.config["api_host_options"][API]
    user = host.username
    password = str(host.password) if host.password is not None else ""
except Exception as e:
    # Not the message: it may quote a line of the config.
    sys.exit(f"skill-container: osc has no usable {API} login ({type(e).__name__})")
if not user or not password:
    sys.exit(f"skill-container: osc stores no password for {API}")
cp = OscConfigParser()
cp.add_section("general")
cp.set("general", "apiurl", API)
cp.add_section(API)
cp.set(API, "user", user)
for key in ("realname", "email"):
    if getattr(host, key, None):
        cp.set(API, key, getattr(host, key))
credentials.PlaintextConfigFileCredentialsManager(cp, None).set_password(API, user, password)
cp.write(sys.stdout)
EOF
}
# tea's config with the src.opensuse.org logins alone; git-obs reads the same file.
tea_login() {
	python3 -I - "$conf/tea/config.yml" <<'EOF'
import sys
from urllib.parse import urlsplit
try:
    from ruamel.yaml import YAML
    yaml = YAML()
    with open(sys.argv[1]) as f:
        logins = [
            login
            for login in yaml.load(f)["logins"]
            if urlsplit(str(login.get("url", ""))).hostname == "src.opensuse.org"
            and login.get("token")
        ]
except Exception as e:
    # Not the message: it may quote a line of the config.
    sys.exit(f"skill-container: cannot read the tea config ({type(e).__name__})")
if not logins:
    sys.exit("skill-container: tea has no src.opensuse.org login with a token")
if not any(login.get("default") for login in logins):
    logins[0]["default"] = True
yaml.dump({"logins": logins}, sys.stdout)
EOF
}
# gh's hosts file with the github.com login alone. gh reads its own store, so a
# token it keeps in a keyring comes out as well.
gh_login() {
	local user token
	{ user=$(gh config get -h github.com user 2>/dev/null) && [[ $user =~ ^[A-Za-z0-9-]+$ ]]; } ||
		die "gh has no github.com login"
	{ token=$(gh auth token --hostname github.com 2>/dev/null) && [[ $token =~ ^[A-Za-z0-9_]+$ ]]; } ||
		die "gh stores no token for github.com"
	printf 'github.com:\n    users:\n        %s:\n            oauth_token: %s\n' "$user" "$token"
	printf '    git_protocol: https\n    user: %s\n    oauth_token: %s\n' "$user" "$token"
}
cmd_secrets() {
	local model_auth='' bugzilla_key=$conf/mcp-bugzilla/api-key osc tea github model newkey='' ownkey='' keydir=''
	while (($#)); do
		case $1 in
		--model-auth)
			model_auth=${2?--model-auth needs an integration}
			shift 2
			;;
		--bugzilla-key)
			bugzilla_key=${2?--bugzilla-key needs a file}
			shift 2
			;;
		--new-ssh-key)
			newkey=1
			shift
			;;
		--ssh-key)
			ownkey=${2?--ssh-key needs a file}
			shift 2
			;;
		*) die "secrets: unknown argument: $1" ;;
		esac
	done
	[ -n "$model_auth" ] || die "secrets: --model-auth <integration> is required"
	[[ $bugzilla_key == /* ]] || bugzilla_key=$start/$bugzilla_key
	{ [ -f "$bugzilla_key" ] && [ -r "$bugzilla_key" ] && [ -s "$bugzilla_key" ]; } ||
		die "no Bugzilla API key at $bugzilla_key"
	[ -z "$ownkey" ] || [ -z "$newkey" ] || die "secrets: --ssh-key names the key, --new-ssh-key makes one: give one of them"
	[[ -z $ownkey || $ownkey == /* ]] || ownkey=$start/$ownkey
	resolve
	# All of them are complete before any replaces the secret of an earlier run.
	osc=$(osc_login)
	tea=$(tea_login)
	github=$(gh_login)
	model=$(PATH=$userpath OPENCODE_DISABLE_PROJECT_CONFIG=1 "$opencode" auth export "$model_auth")
	printf '%s' "$model" | jq -e 'length > 0' >/dev/null 2>&1 ||
		die "opencode exported no credential for $model_auth"
	# Without --ssh-key the key is the container's own: the account's key
	# settings can revoke it alone. A later run keeps the key, or the one you
	# registered would stop working.
	if [ -n "$ownkey" ] || [ -n "$newkey" ] || ! podman secret exists "$name-ssh" 2>/dev/null; then
		keydir=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}") || die "no private directory for the SSH key"
		trap 'rm -rf "$keydir"' EXIT
		if [ -z "$ownkey" ]; then
			ssh-keygen -q -t ed25519 -N '' -C "$name" -f "$keydir/key" >/dev/null || die "no SSH key was made"
		else
			# The copy is what is judged and stored. Nobody types a passphrase
			# in the container, so a key that needs one would never log in.
			{ [ -f "$ownkey" ] && (umask 077 && cp "$ownkey" "$keydir/key") 2>/dev/null &&
				ssh-keygen -y -P '' -f "$keydir/key" </dev/null >/dev/null 2>&1; } ||
				die "no SSH private key without a passphrase at $ownkey"
		fi
	fi
	printf '%s\n' "$osc" | store osc
	printf '%s\n' "$tea" | store tea
	printf '%s\n' "$github" | store github
	printf '%s\n' "$model" | store model
	podman secret create --replace "$name-bugzilla" "$bugzilla_key" >/dev/null
	if [ -n "$keydir" ]; then
		store ssh <"$keydir/key"
		rm -rf "$keydir"
		trap - EXIT
	fi
	printf '%s\n' "$name-osc" "$name-tea" "$name-github" "$name-model" "$name-bugzilla" "$name-ssh"
}
# The public half is no secret; the private one goes to ssh-keygen through a pipe.
cmd_ssh_key() {
	[ $# = 0 ] || die "ssh-key takes no argument"
	podman secret exists "$name-ssh" 2>/dev/null || die "no secret $name-ssh: run 'skill-container secrets' first"
	secret ssh | ssh-keygen -y -f /dev/stdin || die "cannot read the key in $name-ssh"
}
# One instance: a name for the container, its server password and its volumes.
# The logins stay one set per skill and are shared by its instances.
take_instance() {
	inst=${1-}
	# The name goes into a socket path, which is short, and behind a command,
	# where a leading - reads as an option.
	[[ $inst =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,31}$ ]] ||
		die "an instance names the container: letters, digits, _ and - only, at most 32 and not - first"
	ctr=$name-$inst-agent
	unit=$name-agent@$inst.service
	# What install writes: the work directory on the host, the directory it is
	# mounted at inside the container, and the image the container runs. On a
	# managed host the role writes the same three lines under /etc instead,
	# beside the Quadlet template, the instance link and the drop-in it owns;
	# install never writes there.
	statefile=$userconf/$inst.dir
	sysstate=/etc/skill-container/$name/$inst.dir
	dropdir=$HOME/.config/containers/systemd/$name-agent@$inst.container.d
	dropfile=$dropdir/10-workdir.conf
}
readstate() {
	# The user's own install wins; otherwise the role's state under /etc does.
	[ -f "$statefile" ] || [ ! -f "$sysstate" ] || statefile=$sysstate
	[ -f "$statefile" ] || die "$inst is not installed: 'skill-container install $inst' writes it, or the role owns it in $sysstate"
	{
		workdir=$(sed -n 1p "$statefile")
		inside=$(sed -n 2p "$statefile")
		image=$(sed -n 3p "$statefile")
	} 2>/dev/null
	[[ $workdir == /* && $inside == /* && -n $image ]] || die "$statefile is not three lines: install it again"
	case $workdir$inside in
	*[,:]*) die "$statefile holds a path with a comma or a colon: install it again" ;;
	esac
	[ "$(sed -n 4p "$statefile")" = "" ] || die "$statefile holds more than three lines: install it again"
}
# The unit, not the container alone, says whether the instance runs.
running() { systemctl --user is-active --quiet "$unit" 2>/dev/null; }
# The server's plugin list. The guard plugins load in the background after the
# first request; one that failed is listed without its id.
plugins() { timeout -k 5 30 podman exec "$ctr" opencode plugin list --server "$inner" 2>&1 || true; }
# One plugin id per line: a single crafted id naming both guards must not pass.
guarded() {
	local line bug pool
	bug=
	pool=
	while IFS= read -r line; do
		case $line in
		opensuse-packaging.bug-guard\ *) bug=1 ;;
		opensuse-packaging.pool-pr-guard\ *) pool=1 ;;
		esac
	done <<<"$1"
	[ -n "$bug" ] && [ -n "$pool" ]
}
# What a call into the container writes to its error stream may quote the
# server, whose text is the agent's: it passes the filter.
filtered() { { "$@" 2>&1 >&3 3>&- | plain >&2 3>&-; } 3>&1; }
# Fails with 2 when the server answered with an error, which asking again would
# not change: opencode api then ends with 1 and prints the answer, a JSON value.
# Fails with 1 when no answer came.
api() {
	local out rc=0
	out=$(filtered timeout -k 5 30 podman exec "$ctr" opencode api "$@" --server "$inner") || rc=$?
	[ -z "$out" ] || printf '%s\n' "$out"
	[ "$rc" != 0 ] || return 0
	[ "$rc" = 1 ] && jq -es 'length > 0' <<<"$out" >/dev/null 2>&1 && return 2
	return 1
}
# A jq definition: isid passes an id and turns any other value into !, which no
# id matches. Left as it is, an empty id would vanish from the lines the shell
# reads and one with a line break would split into two that look like ids. One
# of more than 128 characters is none either: in a long enough command line the
# call that removes it would not start.
isid='def isid: if type == "string" and length > 0 and length <= 128 and (test("[^A-Za-z0-9_]") | not) then . else "!" end;'
# True when each line of $1 is an id.
onlyids() {
	local id
	[ -n "$1" ] || return 0
	while IFS= read -r id; do
		[[ $id =~ ^[A-Za-z0-9_]{1,128}$ ]] || return 1
	done <<<"$1"
}
# What answers a permission question in place of you is kept in the state
# volume, which the agent writes: the approvals saved for later sessions and a
# session's own rules. opencode writes no such rules itself.
# An approval belongs to a project, and a checkout below the work directory is
# a project of its own. The list is asked for the server's project, for every
# project (an empty id, which is not documented) and for each project by its id.
# Fails with 1 when a list could not be read, with 2 when a project's id is none
# or the server answered with an error.
saved() {
	local answer projects id ids
	answer=$(api GET /api/project) || return
	projects=$(jq -rs "$isid"'if length == 1 and (.[0] | type) == "array" then .[0][].id | isid else error("no list") end' \
		<<<"$answer") || return 1
	onlyids "$projects" || return 2
	mapfile -t ids < <(printf %s "$projects")
	ids=('' "${ids[@]}")
	answer=$(
		api GET /api/permission/saved || exit
		for id in "${ids[@]}"; do
			api GET "/api/permission/saved?projectID=$id" || exit
		done
	) || return
	jq -rs --argjson n "$((${#ids[@]} + 1))" \
		"$isid"'if length == $n and all(.[]; (.data | type) == "array") then map(.data[].id) | unique[] | isid
			else error("an answer is missing or holds no list") end' <<<"$answer" || return 1
}
# The session list is paged and ends with an empty page. Fails with 1 when a
# page could not be read, with 2 when the list does not end or the server
# answered with an error.
ruled() {
	local page n cursor=''
	for _ in $(seq 100); do
		page=$(api GET "/api/session?limit=1000${cursor:+&cursor=$cursor}") || return
		n=$(jq -r 'if (.data | type) == "array" then .data | length else error("no list") end' <<<"$page") || return 1
		[ "$n" != 0 ] || return 0
		jq -r "$isid"'.data[] | select((.permissions // []) != []) | .id | isid' <<<"$page" || return 1
		cursor=$(jq -r '.cursor.next // ""' <<<"$page") || return 1
		[[ $cursor =~ ^[A-Za-z0-9_-]+$ ]] || return 1
	done
	# A list without an end is an answer all the same: asking again pages as long.
	return 2
}
# podman answers nothing, or an error of its own, while another container holds
# its storage lock: what fails is tried again, five seconds apart, for 60 tries
# or until five minutes after the command's first try, whichever ends first: the
# old approvals and login stay live no longer. The first try's errors show, the
# later ones' do not. One that fails with 2 is not tried again: a list holds a
# value that is no id or does not end, or the server answered with an error,
# which asking again would not change.
retried() {
	local n rc
	: "${cutoff:=$((SECONDS + 300))}"
	for ((n = 1; n <= 60; n++)); do
		rc=0
		if ((n == 1)); then "$@" || rc=$?; else "$@" 2>/dev/null || rc=$?; fi
		[ "$rc" != 0 ] || return 0
		[ "$rc" != 2 ] || return 2
		((n < 60 && SECONDS < cutoff)) || return 1
		((n > 1)) || echo "skill-container: could not read or change what $ctr keeps; trying again for up to 5 minutes" >&2
		sleep 5
	done
	return 1
}
# Into forget's approvals and sessions; fails as saved and ruled do, and with 2
# when an approval's or a session's id is none. A failed read leaves no part of
# its lists, ! among them, for the next round to remove.
readperms() {
	local rc=0
	approvals=$(saved) || rc=$?
	[ "$rc" != 0 ] || sessions=$(ruled) || rc=$?
	if [ "$rc" != 0 ]; then
		approvals='' sessions=''
		return "$rc"
	fi
	{ onlyids "$approvals" && onlyids "$sessions"; } || return 2
}
# One round: removes what forget's lists hold and reads them again. A removal
# the busy podman lost leaves its item listed for the next round; one the
# server refused ends the rounds.
clearperms() {
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		[[ $id =~ ^[A-Za-z0-9_]+$ ]] || die "a saved approval of $ctr has an unexpected id: $reset"
		api DELETE "/api/permission/saved/$id" >/dev/null || [ $? != 2 ] || return 2
	done <<<"$approvals"
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		[[ $id =~ ^[A-Za-z0-9_]+$ ]] || die "a session of $ctr has an unexpected id: $reset"
		api PATCH "/api/session/$id" -d '{"permissions":[]}' >/dev/null || [ $? != 2 ] || return 2
	done <<<"$sessions"
	readperms && [ -z "$approvals$sessions" ]
}
# Removes those it finds, and stops when one stays.
forget() {
	local approvals sessions id reset="'podman volume rm $name-$inst-state' removes them, with the sessions"
	retried readperms || die "cannot read the permissions $ctr keeps: $reset"
	[ -n "$approvals$sessions" ] || return 0
	retried clearperms || die "the permissions $ctr keeps cannot be removed: $reset"
	echo "skill-container: removed the saved approvals and session rules of $ctr" >&2
}
# The model login is the secret's alone: one the state volume keeps from an
# earlier secret would stay the active one. The server's list holds the keys.
# An id is checked where it is still one value: a line break inside it makes two.
# No answer is no list: without -s jq takes it for an empty one.
logins() {
	local answer
	answer=$(api GET /api/credential 2>/dev/null) || return
	jq -rs "$isid"'if length == 1 and (.[0].data | type) == "array" then .[0].data[].id | isid else error("no list") end' \
		<<<"$answer" 2>/dev/null || return 1
}
# Into relogin's creds, as readperms.
readlogins() {
	local rc=0
	creds=$(logins) || rc=$?
	if [ "$rc" != 0 ]; then
		creds=''
		return "$rc"
	fi
	onlyids "$creds" || return 2
}
# The server answers the removal of a login it does not hold like any other:
# the list, read again, says what is left. One round, as clearperms.
clearlogins() {
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		[[ $id =~ ^[A-Za-z0-9_]+$ ]] || die "a model login of $ctr has an unexpected id: $reset"
		api DELETE "/api/credential/$id" >/dev/null || [ $? != 2 ] || return 2
	done <<<"$creds"
	readlogins && [ -z "$creds" ]
}
# Its input is the login: what it says about a failure is not shown. It ends
# with 0 when it imported nothing as well: the list, read again, must hold the
# secret's logins and no other.
importlogin() {
	local want
	secret model | timeout -k 5 60 podman exec -i "$ctr" opencode auth import --server "$inner" >/dev/null 2>&1 || return 1
	want=$(secret model | jq -r '.[].id' | sort) || return 1
	readlogins || return
	[ -n "$want" ] && [ "$(sort <<<"$creds")" = "$want" ]
}
relogin() {
	local creds id reset="'podman volume rm $name-$inst-state' removes them, with the sessions; the unit is stopped"
	retried readlogins || die "cannot read the model logins $ctr keeps: $reset"
	retried clearlogins || die "the model logins $ctr keeps cannot be removed: $reset"
	retried importlogin || die "the model credential was not imported; the unit is stopped"
}
# True when one of two directories holds the other.
nested() { [[ $1/ == "$2"/* || $2/ == "$1"/* ]]; }
# Stops unless $1 is what it reads as: podman mounts what a symlink leads to.
real() {
	[ "$(realpath -ms -- "$1")" = "$(realpath -- "$1")" ] ||
		die "refusing $1: a symlink leads to it; name it by its real path"
}
# True when no other user can replace a directory above $1: from / down each
# is root's or yours and takes no entry from group or others, sticky ones
# apart, as far as one that is yours and closed to everyone else: no search
# bit for group or others, where an ACL that lets someone in shows too. With
# "closed" there is such a one.
kept() {
	python3 -I - "$@" <<'EOF'
import os, stat, sys
d, above = sys.argv[1], []
while d != "/":
    d = os.path.dirname(d)
    above.append(d)
for d in reversed(above):
    try:
        st = os.stat(d)
    except OSError:
        continue
    if st.st_uid == os.getuid() and not st.st_mode & 0o011:
        sys.exit(0)
    if st.st_uid not in (0, os.getuid()) or st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX:
        sys.exit(1)
sys.exit(len(sys.argv) > 2)
EOF
}
# The host directories the running containers mount for writing, their volumes
# included. One line per container: its name, then what it mounts.
written() {
	local out ids
	out=$(podman ps --quiet) || return
	[ -n "$out" ] || return 0
	mapfile -t ids <<<"$out"
	podman inspect --format '{{.Name}}|{{range .Mounts}}{{if .RW}}|{{.Source}}{{end}}{{end}}' "${ids[@]}"
}
# The checks a work directory passes before the agent writes it: it is one you
# own, apart from your home directory and what holds your logins, with a
# directory above it that is yours and closed to everyone else, and no running
# container writes above or below it. Reads the globals workdir and inside.
check_workdir() {
	local out other store volumes runtime home
	[ -d "$workdir" ] || die "not a directory: $workdir"
	real "$workdir"
	workdir=$(realpath -- "$workdir")
	offpath "$workdir"
	home=$(realpath -- "$HOME")
	store=$(podman info --format '{{.Store.GraphRoot}}')
	volumes=$(podman info --format '{{.Store.VolumePath}}')
	runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
	# The mount gives the agent the whole tree and relabels it for this
	# container alone: not the home directory, what holds it, the logins,
	# podman's secrets or the sockets of your session.
	if [ "$workdir" = / ] || [ ! -O "$workdir" ] || [[ $home/ == "$workdir"/* || $workdir/ == "$home"/.* ]] ||
		nested "$workdir" "$(realpath -m -- "$conf")" || nested "$workdir" "$(realpath -m -- "$store")" ||
		nested "$workdir" "$(realpath -m -- "$volumes")" || nested "$workdir" "$(realpath -m -- "$runtime")"; then
		die "refusing $workdir: the work directory is one you own, apart from your home directory and what holds your logins, podman's storage or your runtime directory"
	fi
	case $workdir in
	*[,:]*) die "podman cannot mount a path with a comma or a colon: $workdir" ;;
	esac
	# The agent runs as you: a file it makes setuid in what it writes on the
	# host runs as you for whoever can reach it.
	kept "$workdir" closed ||
		die "refusing $workdir: it needs a directory above it that is yours and closed to other users (mode 0700), with none further up that another user can write: the agent can leave a setuid file there"
	kept "$(realpath -m -- "$volumes")/$name-$inst-state" closed ||
		die "refusing to start: podman's volumes in $volumes need a directory above them that is yours and closed to other users (mode 0700), with none further up that another user can write"
	# An agent that writes a directory above the one mounted next can put a link
	# there between the checks above and the mount.
	out=$(written) || die "cannot list what the running containers mount"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		IFS='|' read -ra parts <<<"$line"
		[ "${parts[0]#/}" = "$ctr" ] && continue
		for other in "${parts[@]:1}"; do
			[ -n "$other" ] || continue
			other=$(realpath -m -- "$other")
			! nested "$workdir" "$other" || die "refusing $workdir: a running container writes $other"
		done
	done <<<"$out"
}
# The checks a memory graph passes before it is seeded into the instance: a
# file alone in its directory, holding entities and relations only, outside
# the work directory and podman's storage and volumes, where no running
# container writes. Reads the globals workdir and memory.
check_memory() {
	local memdir out other store volumes
	[ -f "$memory" ] || die "not a file: $memory"
	real "$memory"
	memory=$(realpath -- "$memory")
	memdir=${memory%/*}
	{ [ "$(ls -A -- "$memdir")" = "${memory##*/}" ] &&
		jq -es 'all(.[]; .type == "entity" or .type == "relation")' "$memory" >/dev/null 2>&1; } ||
		die "refusing $memory: the memory graph is a file alone in its directory, with entities and relations only"
	[[ $memdir/ != "$workdir"/* ]] || die "refusing $memory: it lies in the work directory"
	store=$(podman info --format '{{.Store.GraphRoot}}')
	volumes=$(podman info --format '{{.Store.VolumePath}}')
	if nested "$memdir" "$(realpath -m -- "$store")" || nested "$memdir" "$(realpath -m -- "$volumes")"; then
		die "refusing $memory: it lies in podman's storage"
	fi
	kept "$memory" || die "refusing $memory: another user can write a directory above it"
	case $memory in
	*[,:]*) die "podman cannot mount a path with a comma or a colon: $memory" ;;
	esac
	out=$(written) || die "cannot list what the running containers mount"
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		IFS='|' read -ra parts <<<"$line"
		[ "${parts[0]#/}" = "$ctr" ] && continue
		for other in "${parts[@]:1}"; do
			[ -n "$other" ] || continue
			other=$(realpath -m -- "$other")
			! nested "$memdir" "$other" || die "refusing $memory: a running container writes $other"
		done
	done <<<"$out"
}
# Where install writes: see take_instance for dropdir and dropfile.
# The fixed copy the update service runs: install refuses without an
# identical one, so the timer and your shell run the code you reviewed.
# ("bin" is quoted: the test suite refuses an absolute command path here.)
fixedcopy=$HOME/.local/"bin"/skill-container
cmd_install() {
	local memdir image_arg='' as='' memory='' gitname gitmail v over top covers
	workdir='' inside=''
	while (($#)); do
		case $1 in
		--workdir)
			workdir=${2?--workdir needs a directory}
			shift 2
			;;
		--as)
			as=${2?--as needs a directory}
			shift 2
			;;
		--memory)
			memory=${2?--memory needs a file}
			shift 2
			;;
		--image)
			image_arg=${2?--image needs an image}
			shift 2
			;;
		*) die "install: unknown argument: $1" ;;
		esac
	done
	[ -n "$workdir" ] || die "install: --workdir <directory> is required"
	# A managed host's role owns this instance: installing beside its units
	# would shadow them, so install writes nothing there.
	[ ! -f "$sysstate" ] || die "$inst is managed by the role: its state is $sysstate, install writes nothing there"
	[[ $workdir == /* ]] || workdir=$start/$workdir
	inside=${as:-$workdir}
	[[ $inside == /* ]] || inside=$start/$inside
	case $inside in
	*[,:]*) die "podman cannot mount a path with a comma or a colon: $inside" ;;
	esac
	# The work directory is the agent's: mounted over what the image holds, it
	# would put the guards, their rules or the tools into the agent's hands.
	# /bin, /sbin, /lib and /lib64 are links into /usr there, and /var holds
	# links into /usr and /run and the certificates /etc names. /var/tmp is a
	# volume the agent writes: a link it leaves there for the mount point
	# leads the next start's mount wherever it points. /tmp is new at each start.
	over=$(realpath -ms -- "$inside")
	covers=
	[ "$over" != / ] && [ "$over" != /tmp ] || covers=1
	for top in /etc /usr /bin /sbin /lib /lib64 /boot /dev /proc /sys /run /root /var /home/agent; do
		! nested "$over" "$top" || covers=1
	done
	[ -z "$covers" ] || die "refusing to mount the work directory at $inside: it would cover what the image holds or the system keeps there (/etc, /usr and the links into it, /boot, /dev, /proc, /sys, /run, /root, /var, /home/agent), or be /tmp itself; name another place with --as"
	image=${image_arg:-localhost/$name-agent:latest}
	# All checks pass before anything is written.
	check_workdir
	if [ -n "$memory" ]; then
		[[ $memory == /* ]] || memory=$start/$memory
		check_memory
	fi
	# The drop-in is a unit file: systemd expands a % and a $, reads a new line or
	# a carriage return as a setting of its own, joins the next line after a
	# backslash and ends a quoted value at a double quote.
	for v in "$workdir" "$inside" "$image" "$userconf"; do
		case $v in
		*[[:cntrl:]]* | *%* | *\$* | *\\* | *\"*)
			die "install refuses a path or an image name with a control character, a %, a \$, a backslash or a double quote"
			;;
		esac
	done
	for s in osc tea github bugzilla model ssh; do
		podman secret exists "$name-$s" || die "no secret $name-$s: run 'skill-container secrets' first"
	done
	cmp -s "$self" "$fixedcopy" || die "copy the launcher to $fixedcopy first, then run install again"
	[ -x "$fixedcopy" ] || die "$fixedcopy is not executable"
	# The units this skill ships: the agent, what its service needs, the
	# relay and the nightly update. The timer stays disabled until you
	# enable it after one watched run. Beside the fixed copy of the launcher,
	# where you put them, or under /etc, where the role keeps them on a managed
	# host: never beside the launcher that runs, which may lie where an agent
	# writes.
	srcdir=
	for cand in "${fixedcopy%/*}/systemd" /etc/skill-container/systemd; do
		srcok=1
		for f in "$cand/$name-agent@.container" \
			"$cand/$name-agent@.service.d/10-relay.conf" \
			"$cand/$name-agent@.service.d/20-depend.conf" \
			"$cand/$name-relay@.service" \
			"$cand/$name-update@.service" "$cand/$name-update@.timer"; do
			[ -f "$f" ] || {
				srcok=''
				break
			}
		done
		[ -z "$srcok" ] || {
			srcdir=$cand
			break
		}
	done
	[ -n "$srcdir" ] || die "no units in ${fixedcopy%/*}/systemd or /etc/skill-container/systemd: copy the launcher's systemd directory there"
	# A unit is a command line systemd runs as you.
	srcdir=$(realpath -- "$srcdir")
	kept "$srcdir/unit" || die "refusing the units in $srcdir: another user can replace them"
	# The memory graph first: a copy that fails leaves an earlier install of
	# the instance as it was.
	if [ -n "$memory" ]; then
		memdir=${memory%/*}
		podman run --rm --userns=keep-id --user "$(id -u):$(id -g)" --read-only --cap-drop=all \
			--security-opt no-new-privileges --init \
			--volume "$name-$inst-memory:/seed:U" --volume "$memdir:/src:ro,Z" \
			"$image" cp -n "/src/${memory##*/}" "/seed/$memname" >/dev/null ||
			die "the memory graph was not seeded: nothing of $inst was written"
	fi
	mkdir -p "$dropdir" "$userconf"
	# git refuses to commit without a name, and the container's home is read-only:
	# the host's own identity goes in as a file of the instance's own.
	gitname=$(git config --global --includes --get user.name 2>/dev/null) || gitname=
	gitmail=$(git config --global --includes --get user.email 2>/dev/null) || gitmail=
	rm -f "$userconf/$inst.gitconfig"
	case $userconf in
	*[,:]*) ;;
	*)
		if [ -n "$gitname" ] && [ -n "$gitmail" ]; then
			{
				git config --file "$userconf/$inst.gitconfig" user.name "$gitname" &&
					git config --file "$userconf/$inst.gitconfig" user.email "$gitmail"
			} || die "cannot write $userconf/$inst.gitconfig"
		fi
		;;
	esac
	# The instance is a symlink to the template: only then does quadlet
	# read the instance's drop-in directory for it.
	ln -sf "$name-agent@.container" "$HOME/.config/containers/systemd/$name-agent@$inst.container"
	unitdir=$HOME/.config/containers/systemd
	svcdir=$HOME/.config/systemd/user
	cp "$srcdir/$name-agent@.container" "$unitdir/"
	mkdir -p "$svcdir/$name-agent@.service.d"
	cp "$srcdir/$name-agent@.service.d/10-relay.conf" "$srcdir/$name-agent@.service.d/20-depend.conf" \
		"$svcdir/$name-agent@.service.d/"
	cp "$srcdir/$name-relay@.service" "$srcdir/$name-update@.service" "$srcdir/$name-update@.timer" \
		"$svcdir/"
	{
		echo "# Written by skill-container install $inst. Do not edit: install writes it again."
		echo "[Container]"
		echo "Volume=$workdir:$inside:Z"
		echo "WorkingDir=$inside"
		# The image update pulls is the one the unit runs, whatever the template names.
		echo "Image=$image"
		[ ! -s "$userconf/$inst.gitconfig" ] || echo "Volume=$userconf/$inst.gitconfig:/home/agent/.config/git/config:ro,Z"
	} >"$dropfile"
	printf '%s\n' "$workdir" "$inside" "$image" >"$statefile"
	systemctl --user daemon-reload >/dev/null ||
		die "systemd would not reload: the files of $inst are written and not loaded yet; run install again"
	echo "$inst is installed: work directory $workdir, mounted at $inside"
}
# Starts the unit and waits until the server has loaded both guard plugins;
# a failed or interrupted start stops the unit again.
start_wait() {
	local out='' probes=0 deadline=$((SECONDS + 300))
	trap 'systemctl --user stop "$unit" >/dev/null 2>&1; trap - EXIT INT TERM HUP' EXIT
	trap 'exit 130' INT TERM HUP
	# Earlier failed starts count against the unit's start limit.
	systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
	systemctl --user start "$unit" >/dev/null || die "$inst would not start"
	while ((SECONDS < deadline)); do
		running || die "$inst stopped while starting; the unit is stopped"
		out=$(plugins)
		if guarded "$out" || [[ $out == *$'\n'"- "* ]]; then break; fi
		# Each probe writes lines to the journal, and the plugins can take minutes.
		probes=$((probes + 1))
		if ((probes <= 30)); then sleep 1; else sleep 5; fi
	done
	if ! guarded "$out"; then
		podman logs --tail 20 "$ctr" 2>&1 | plain >&2 || true
		die "the server did not load both guard plugins; the unit is stopped: $(plain <<<"$out")"
	fi
	trap - INT TERM HUP
}
cmd_up() {
	local model='' out='' json
	while (($#)); do
		case $1 in
		--model)
			model=${2?--model needs provider/model}
			shift 2
			;;
		*) die "up: unknown argument: $1" ;;
		esac
	done
	readstate
	check_workdir
	! running || die "$inst is already running: 'skill-container down $inst' stops it"
	for s in osc tea github bugzilla model ssh; do
		podman secret exists "$name-$s" || die "no secret $name-$s: run 'skill-container secrets' first"
	done
	mkdir -p "$userconf"
	if [ -n "$model" ]; then
		[ -s "$userconf/opencode.json" ] || echo '{}' >"$userconf/opencode.json"
		json=$(jq --arg m "$model" '.model = $m' "$userconf/opencode.json") || die "not JSON: $userconf/opencode.json"
		printf '%s\n' "$json" >"$userconf/opencode.json"
	fi
	# The server asks every client for a password; it was created on the first
	# start by ensure_password and keeps that value afterwards.
	ensure_password
	start_wait
	forget
	relogin
	trap - EXIT
	echo "$inst is up, work directory $workdir"
}
cmd_down() {
	[ $# = 0 ] || die "down takes no argument"
	readstate
	systemctl --user stop "$unit" >/dev/null 2>&1 || die "$inst would not stop"
	echo "$inst is stopped; its volumes and secrets stay"
}
# Works without a state file: a unit started by its name alone is stopped too.
cmd_uninstall() {
	local u
	[ $# = 0 ] || die "uninstall takes no argument"
	[ ! -f "$sysstate" ] || die "$inst is managed by the role: its state is $sysstate, uninstall removes nothing there"
	systemctl --user disable --now "$name-update@$inst.timer" >/dev/null 2>&1 || true
	for u in "$name-relay@$inst.service" "$unit"; do
		systemctl --user stop "$u" >/dev/null 2>&1 || true
	done
	! running || die "$inst would not stop"
	rm -f "$dropfile" "$statefile" "$userconf/$inst.gitconfig" "$HOME/.config/containers/systemd/$name-agent@$inst.container"
	[ ! -d "$dropdir" ] || rmdir "$dropdir" 2>/dev/null || true
	systemctl --user daemon-reload >/dev/null || die "systemd would not reload"
	systemctl --user reset-failed "$unit" "$name-relay@$inst.service" >/dev/null 2>&1 || true
