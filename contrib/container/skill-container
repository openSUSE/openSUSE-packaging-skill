}
cmd_update() {
	local want have
	[ $# = 0 ] || die "update takes no argument"
	readstate
	check_workdir
	running || die "$inst is not running: 'skill-container up $inst' starts it"
	if [[ $image != localhost/* ]]; then
		podman pull "$image" >/dev/null || die "the image was not pulled"
	fi
	want=$(podman image inspect --format '{{.Id}}' "$image" 2>/dev/null) || die "no image $image"
	have=$(podman inspect --format '{{.Image}}' "$ctr") || die "cannot read the image of $ctr"
	if [ "$want" = "$have" ]; then
		echo "$inst runs the newest $image already"
		return 0
	fi
