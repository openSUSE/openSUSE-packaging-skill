{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "bugzilla": {
        "type": "local",
        "command": [
          "bugwarden",
          "--transport",
          "stdio",
          "--bugzilla-server",
          "https://bugzilla.suse.com",
          "--api-key-file",
          "/home/agent/.config/mcp-bugzilla/api-key",
          "--policy",
          "/etc/bugwarden/policy.toml"
        ],
        "codemode": false
      },
      "memory": {
        "type": "local",
        "command": [
          "mcp-server-memory"
        ],
        "codemode": false
      },
      "sequentialthinking": {
        "type": "local",
        "command": [
          "mcp-server-sequential-thinking"
        ],
        "codemode": false
      }
    }
  },
  "permissions": [
    {
      "action": "opencode_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode auth*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode.db*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*opencode.db*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode api*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode run*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode serve*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode acp*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode mini*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode session*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode service*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode pair*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode*--server*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*opencode*--standalone*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*OPENCODE_PASSWORD*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*oauth_token*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*/proc/*environ*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/proc/*environ*",
      "effect": "deny"
    }
  ]
}
